{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      "@spartan-ng/helm/utils": ["src/app/components/ui/ui-utils"],
      "@spartan-ng/helm/button": ["src/app/components/ui/ui-button-helm"],
      "@spartan-ng/helm/card": ["src/app/components/ui/ui-card-helm"],
      "@spartan-ng/helm/separator": ["src/app/components/ui/ui-separator-helm"],
      "@spartan-ng/helm/badge": ["src/app/components/ui/ui-badge-helm"],
      "@spartan-ng/helm/tooltip": ["src/app/components/ui/ui-tooltip-helm"],
      "@spartan-ng/helm/icon": ["src/app/components/ui/ui-icon-helm"],
      "@spartan-ng/helm/dialog": ["src/app/components/ui/ui-dialog-helm"],
      "@spartan-ng/helm/sheet": ["src/app/components/ui/ui-sheet-helm"],
      "@spartan-ng/helm/tabs": ["src/app/components/ui/ui-tabs-helm"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
